// Prisma schema for BookThePlace
// Marketplace: ludzie udostępniają sale/miejsca na imprezy okolicznościowe
// (wesela, urodziny, konferencje itd.), pokazują wolne terminy i przyjmują rezerwacje.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?

  venues   Venue[]   @relation("OwnerVenues")
  bookings Booking[] @relation("CustomerBookings")
  reviews  Review[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modele wymagane przez @auth/prisma-adapter (NextAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Venue {
  id          String  @id @default(cuid())
  name        String
  description String  @db.Text
  city        String
  address     String
  capacity    Int
  pricePerDay Decimal @db.Decimal(10, 2)

  amenities String[] // np. ["parking", "catering", "nagłośnienie"]
  images    VenueImage[]

  owner   User   @relation("OwnerVenues", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  bookings      Booking[]
  availability  Availability[]
  reviews       Review[]

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([ownerId])
}

model VenueImage {
  id      String @id @default(cuid())
  url     String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId String
}

// Blokady/wolne terminy ustawiane ręcznie przez właściciela (np. dni niedostępne)
model Availability {
  id        String   @id @default(cuid())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId   String
  date      DateTime
  isBlocked Boolean  @default(false) // true = właściciel ręcznie zablokował dzień

  @@unique([venueId, date])
  @@index([venueId])
}

model Booking {
  id      String        @id @default(cuid())
  venue   Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId String

  customer   User   @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  eventDate DateTime
  guests    Int
  message   String?       @db.Text
  status    BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, eventDate])
  @@index([customerId])
}

model Review {
  id      String @id @default(cuid())
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  rating  Int // 1-5
  comment String? @db.Text

  createdAt DateTime @default(now())

  @@index([venueId])
}
